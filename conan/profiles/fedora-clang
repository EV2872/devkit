[settings]
os=Linux
arch=x86_64
compiler=clang
compiler.version=22
compiler.libcxx=libstdc++11
compiler.cppstd=20
build_type=Debug

[buildenv]
CC=clang
CXX=clang++

[conf]
tools.build:compiler_executables={"c": "clang", "cpp": "clang++"}
tools.cmake.cmaketoolchain:generator=Ninja
tools.build:jobs=0
# ignorar c2y warnings por culpa de google-benchmark
tools.build:cxxflags=["-Wno-c2y-extensions", "-Wno-unknown-warning-option"]
tools.build:cflags=["-Wno-c2y-extensions", "-Wno-unknown-warning-option"]