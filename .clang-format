# ==============================================================================
# .clang-format
# Basado en el estilo de Google, con ajustes mínimos y documentados.
# ==============================================================================
BasedOnStyle: Google

Language: Cpp
Standard: c++20

ColumnLimit: 100          # Google usa 80 por defecto; 100 es más cómodo en pantallas modernas
IndentWidth: 4            # Google usa 2; 4 es preferencia explícita del proyecto
AccessModifierOffset: -2

# Punteros/referencias pegados al tipo, no al nombre (coherente con Google style)
DerivePointerAlignment: false
PointerAlignment: Left

# Orden de includes: agrupa y ordena alfabéticamente dentro de cada bloque
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<gtest/|^<gmock/'
    Priority: 1
  - Regex: '^<fmt/'
    Priority: 2
  - Regex: '^"devkit/'
    Priority: 3
  - Regex: '^<'
    Priority: 0
  - Regex: '.*'
    Priority: 4

SortIncludes: CaseSensitive

# Llaves al estilo "attach" (Google), no Allman
BreakBeforeBraces: Attach

AllowShortFunctionsOnASingleLine: Empty
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

BinPackArguments: false
BinPackParameters: false

SpaceBeforeParens: ControlStatements